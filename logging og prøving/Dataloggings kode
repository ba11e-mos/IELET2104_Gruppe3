(* 1. Timer-styring: Går hvert 500ms (K50) når Run_Logging er høy *)
OUT_T(Run_Logging, Log_Timer, K5); 

(* 2. Logging-logikk *)
IF Log_Timer.TS THEN
    
    (* Sjekk at vi ikke skriver utenfor array-størrelsen (0 til 99) *)
    IF Index <= 99 THEN
        
        (* Valgfritt: Skalering fra 0-4000 bits til 0-60 cm *)
        (* Vi bruker 100 som multiplikator for å beholde én desimal i et heltall (452 = 45.2 cm) *)
        Log_Array[Index] := (Raw_Level * 60) / 4000;
        
        (* Øk indeksen for neste måling *)
        Index := Index + 1;
        
    ELSE
        (* Stopper logging når arrayet er fullt *)
        Run_Logging := FALSE;
    END_IF;

END_IF;

(* 3. Reset-logikk: Nullstill index når vi skrur av loggingen *)
IF NOT Run_Logging THEN
    Index := 0;
END_IF;


